generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  name        String
  emailVerified DateTime?
  image       String?
  password    String?        // hashed, null for OAuth users
  avatar      String?
  bio         String?
  niche       String?
  tier        String         @default("creator")
  // Stripe / Subscription
  stripeCustomerId   String?  @unique
  plan               String   @default("free")
  planStatus         String   @default("active")
  planCurrentPeriodEnd DateTime?
  aiUsageThisMonth   Int      @default(0)
  aiUsageResetAt     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  accounts    Account[]
  sessions    Session[]
  goals       Goal[]
  campaigns   Campaign[]
  incomes     Income[]
  metrics     SocialMetric[]
  aiUsages    AiUsage[]
  brandDeals  BrandDeal[]
  contentPosts ContentPost[]
  competitors Competitor[]
  playbookProgress PlaybookProgress[]
  socialAccounts SocialAccount[]
  subscription Subscription?
  marketplaceApplications MarketplaceApplication[]
  contracts       Contract[]
}

// ── NextAuth models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  stripePriceId        String
  plan                 String    // free | creator | pro
  status               String    // active | canceled | past_due | trialing | incomplete | unpaid
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Goal {
  id           String    @id @default(cuid())
  title        String
  description  String?
  category     String
  platform     String?
  targetValue  Float
  currentValue Float     @default(0)
  unit         String    @default("")
  deadline     DateTime?
  status       String    @default("active")
  priority     String    @default("medium")
  score        Float?
  notes        String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Campaign {
  id           String    @id @default(cuid())
  name         String
  description  String?
  objective    String
  platform     String
  budget       Float     @default(0)
  spent        Float     @default(0)
  startDate    DateTime
  endDate      DateTime?
  status       String    @default("draft")
  impressions  Int       @default(0)
  reach        Int       @default(0)
  engagement   Int       @default(0)
  conversions  Int       @default(0)
  clicks       Int       @default(0)
  content      String?
  tags         String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Income {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("USD")
  source      String
  platform    String?
  description String?
  date        DateTime
  invoiced    Boolean  @default(false)
  paid        Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialMetric {
  id          String   @id @default(cuid())
  platform    String
  followers   Int      @default(0)
  following   Int      @default(0)
  posts       Int      @default(0)
  engagement  Float    @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  date        DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, date])
}

model AiUsage {
  id        String   @id @default(cuid())
  type      String
  prompt    String
  result    String
  platform  String?
  saved     Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ========================
// NEW MODELS
// ========================

model BrandDeal {
  id            String    @id @default(cuid())
  brand         String
  contact       String?
  email         String?
  phone         String?
  platform      String    // instagram | tiktok | youtube | multi
  type          String    // sponsored_post | video | story | reel | series | ambassador | affiliate | ugc
  stage         String    @default("outreach") // outreach | negotiation | contract | active | delivered | completed | declined
  value         Float     @default(0)
  currency      String    @default("USD")
  commissionPct Float?    // for affiliate deals
  dueDate       DateTime?
  description   String?
  deliverables  String?   // JSON: ["1 Reel", "3 Stories", "1 Post"]
  notes         String?
  tags          String?
  logo          String?   // brand logo URL
  niche         String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ContentPost {
  id          String    @id @default(cuid())
  title       String
  caption     String?
  platform    String    // instagram | tiktok | youtube | twitter | linkedin
  type        String    // reel | post | story | video | thread | carousel | short
  status      String    @default("idea") // idea | draft | ready | scheduled | published | archived
  scheduledAt DateTime?
  publishedAt DateTime?
  hashtags    String?
  notes       String?
  hookText    String?   // first line / hook
  imageUrl    String?   // public URL of the image/video to publish
  viralScore  Float?    // 0-100
  performance String?   // JSON: { likes, comments, shares, views, reach }
  // Publishing fields
  publishedMediaId  String?   // Instagram media ID after publishing
  publishError      String?   // last error if publishing failed
  publishAttempts   Int       @default(0)
  campaignId  String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Competitor {
  id            String   @id @default(cuid())
  name          String
  handle        String
  platform      String
  profileUrl    String?
  followers     Int      @default(0)
  engagement    Float    @default(0)
  avgLikes      Int      @default(0)
  avgComments   Int      @default(0)
  postsPerWeek  Float    @default(0)
  niche         String?
  contentTypes  String?  // comma-separated: reels,carousels,stories
  strengths     String?
  weaknesses    String?
  notes         String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlaybookProgress {
  id          String   @id @default(cuid())
  playbookId  String   // e.g. "0-1k", "1k-10k", "monetize"
  checklistId String   // specific item id
  completed   Boolean  @default(false)
  completedAt DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, playbookId, checklistId])
}

// ========================
// SOCIAL OAUTH ACCOUNTS
// ========================

model SocialAccount {
  id               String   @id @default(cuid())
  platform         String   // instagram | tiktok | youtube | linkedin | twitter
  platformUserId   String   // the ID on that platform
  username         String
  displayName      String?
  profilePicture   String?
  accessToken      String   // long-lived token
  refreshToken     String?
  tokenExpiresAt   DateTime?
  scopes           String?  // comma-separated granted scopes
  isActive         Boolean  @default(true)
  followersCount   Int      @default(0)
  followingCount   Int      @default(0)
  mediaCount       Int      @default(0)
  biography        String?
  website          String?
  accountType      String?  // PERSONAL | BUSINESS | CREATOR
  lastSyncAt       DateTime?
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots        SocialSnapshot[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, platform, platformUserId])
}

model SocialSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  platform        String
  followers       Int      @default(0)
  following       Int      @default(0)
  mediaCount      Int      @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  profileViews    Int      @default(0)
  websiteClicks   Int      @default(0)
  engagement      Float    @default(0)
  newFollowers    Int      @default(0)
  avgLikes        Float    @default(0)
  avgComments     Float    @default(0)
  topPostId       String?
  topPostLikes    Int      @default(0)
  rawData         String?  // JSON with full API response
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  userId          String
  createdAt       DateTime @default(now())

  @@index([userId, platform, date])
  @@unique([socialAccountId, date])
}

model InstagramMedia {
  id               String   @id @default(cuid())
  igMediaId        String   @unique // Instagram media ID
  mediaType        String   // IMAGE | VIDEO | CAROUSEL_ALBUM | REEL
  caption          String?
  mediaUrl         String?
  thumbnailUrl     String?
  permalink        String?
  timestamp        DateTime
  likeCount        Int      @default(0)
  commentsCount    Int      @default(0)
  impressions      Int      @default(0)
  reach            Int      @default(0)
  saved            Int      @default(0)
  videoViews       Int      @default(0)
  engagement       Float    @default(0)
  socialAccountId  String
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, timestamp])
}

// ========================
// INFLUENCER DISCOVERY
// ========================

model InfluencerProfile {
  id            String   @id @default(cuid())
  name          String
  handle        String
  platform      String   // instagram | tiktok | youtube | linkedin | twitter
  profileUrl    String?
  avatarUrl     String?
  niche         String?
  location      String?
  bio           String?
  followers     Int      @default(0)
  engagement    Float    @default(0)
  avgViews      Int      @default(0)
  estimatedRate Int      @default(0)
  verified      Boolean  @default(false)
  topics        String?  // comma-separated: fitness,nutrición,lifestyle
  recentGrowth  String?  // e.g. "+2.1K/sem"
  contactEmail  String?
  addedById     String?  // User ID who added it (Pro users)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([handle, platform])
  @@index([platform, niche, followers])
}

// ========================
// MARKETPLACE
// ========================

model MarketplaceListing {
  id           String   @id @default(cuid())
  title        String
  brandName    String
  brandLogo    String?
  budget       Float    @default(0)
  budgetType   String   @default("fixed")  // fixed | range | negotiable
  budgetMax    Float?
  currency     String   @default("USD")
  type         String   // sponsored_post | video | reel | story | ambassador | ugc | affiliate | series
  platforms    String   // comma-separated: instagram,tiktok,youtube
  niche        String?
  description  String
  deliverables String?  // JSON array string
  deadline     DateTime?
  requirements String?  // follower min, engagement min, etc.
  location     String?  // "Global" | "España" | "México" ...
  status       String   @default("open") // open | paused | filled | closed
  featured     Boolean  @default(false)
  applicantsCount Int   @default(0)
  postedById   String?  // User who posted (Pro users can post)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications MarketplaceApplication[]
}

model MarketplaceApplication {
  id           String   @id @default(cuid())
  message      String
  proposedRate Float?
  portfolio    String?  // URLs comma-separated
  status       String   @default("pending") // pending | viewed | shortlisted | accepted | rejected
  listingId    String
  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([listingId, userId])
}

// ========================
// CONTRACTS
// ========================

model Contract {
  id        String   @id @default(cuid())
  title     String
  type      String   // sponsored | ambassador | ugc | affiliate
  fields    String   // JSON of form field values
  content   String   // generated contract text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
