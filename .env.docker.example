# ══════════════════════════════════════════════════════════════
#  Influctor — Variables de entorno para el stack de Portainer
#
#  Copia este archivo a .env.docker, llena los valores
#  y súbelo en Portainer → Stacks → Load variables from .env file
#  O bien define cada variable manualmente en la UI de Portainer.
# ══════════════════════════════════════════════════════════════

# ── Obligatorias ──────────────────────────────────────────────

# Contraseña de PostgreSQL (solo letras y números, sin caracteres especiales)
# Generar: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 24
DB_PASSWORD=cambia-esto-por-una-password-segura

# Secreto de NextAuth
# Generar: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-largo

# URL pública de la app (sin trailing slash)
APP_URL=https://app.tudominio.com

# Secreto para los cron jobs
# Generar: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 32
CRON_SECRET=cambia-esto-por-otro-secreto

# ── Opcional ──────────────────────────────────────────────────

# Puerto en el host donde se expone la app (default: 3010)
# Usa uno libre en tu servidor para no chocar con otros contenedores
APP_PORT=3010
