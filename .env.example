# ==============================
# Base de datos — PostgreSQL (Supabase recomendado)
#
# Supabase local con Orion:
#   npx supabase start → copia el DB URL
#   DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
#
# Supabase cloud (gratis):
#   https://supabase.com → Settings → Database → URI
#   DATABASE_URL="postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres"
#
# Otras opciones: Neon, Railway, Docker local
# ==============================
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ==============================
# NextAuth
# Genera el secret con: openssl rand -base64 32
# NEXTAUTH_URL: URL pública de la app (sin trailing slash)
# ==============================
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-domain.com"

# ==============================
# Google OAuth (opcional)
# Crea credenciales en: https://console.cloud.google.com/apis/credentials
# Tipo: "OAuth 2.0 Client ID" → Web application
# Redirect URI: https://your-domain.com/api/auth/callback/google
# ==============================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="0"

# ==============================
# Instagram / Meta OAuth
# Obtén estas credenciales en: https://developers.facebook.com
# Redirect URI: https://your-domain.com/api/auth/instagram/callback
# ==============================
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ==============================
# TikTok Developer App
# Crea tu app en: https://developers.tiktok.com
# Agrega producto: Login Kit
# Redirect URI: https://your-domain.com/api/auth/tiktok/callback
# Scopes: user.info.basic, user.info.stats, video.list
# ==============================
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Secret para proteger el endpoint de cron
CRON_SECRET="change-this-to-a-random-secret"

# ==============================
# Stripe
# https://dashboard.stripe.com/apikeys
# Crea los productos Creator ($19/mes) y Pro ($49/mes) en el dashboard.
# Webhook events:
#   customer.subscription.created / updated / deleted
#   invoice.payment_succeeded / payment_failed
# ==============================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_PRO=""

# ==============================
# Resend (Email)
# https://resend.com/api-keys
# EMAIL_FROM: "Influctor <noreply@tudominio.com>"
# ==============================
RESEND_API_KEY=""
EMAIL_FROM="Influctor <noreply@tudominio.com>"

# ==============================
# Storage de archivos — MinIO (imágenes, documentos, avatares)
#
# MinIO local con Orion / Docker:
#   Puerto API:     9000
#   Puerto consola: 9001  →  http://localhost:9001
#   Usuario y contraseña por defecto: minioadmin / minioadmin
#
#   1. Entra a la consola http://localhost:9001
#   2. Crea un bucket llamado "influctor" (o el nombre que quieras)
#   3. Ponlo en modo público si quieres URLs directas, o deja privado y usa presigned URLs
#
# STORAGE_ENDPOINT   → URL de la API de MinIO (sin trailing slash)
# STORAGE_PUBLIC_URL → URL pública para acceder a los archivos subidos
#                      Local:      http://localhost:9000/influctor
#                      Producción: https://storage.tudominio.com/influctor
# ==============================
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="influctor"
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_URL="http://localhost:9000/influctor"

# ==============================
# Rate limiting — Redis (tu servidor existente)
#
# Sin esta variable la app usa rate limiting en memoria (solo funciona
# en single-instance). Con Redis funciona en cualquier despliegue.
#
# Formatos:
#   redis://localhost:6379
#   redis://:password@host:6379
#   rediss://host:6380          ← con TLS
# ==============================
REDIS_URL="redis://localhost:6379"
