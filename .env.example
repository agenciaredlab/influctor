# ==============================
# Base de datos — PostgreSQL
# Elige uno de los siguientes proveedores:
#
# Neon (recomendado, gratis):
#   https://neon.tech → New project → Connection string
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase (gratis):
#   https://supabase.com → Settings → Database → URI
#   DATABASE_URL="postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres"
#
# Railway:
#   https://railway.app → New → PostgreSQL → Connect → Postgres URL
#   DATABASE_URL="postgresql://postgres:pass@roundhouse.proxy.rlwy.net:PORT/railway"
#
# Local (Docker):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influctor"
# ==============================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ==============================
# NextAuth
# Genera el secret con: openssl rand -base64 32
# NEXTAUTH_URL: URL pública de la app (sin trailing slash)
# ==============================
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-domain.com"

# ==============================
# Google OAuth (opcional)
# Crea credenciales en: https://console.cloud.google.com/apis/credentials
# Tipo: "OAuth 2.0 Client ID" → Web application
# Redirect URI: https://your-domain.com/api/auth/callback/google
# ==============================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="0"

# ==============================
# Instagram / Meta OAuth
# Obtén estas credenciales en: https://developers.facebook.com
# Redirect URI: https://your-domain.com/api/auth/instagram/callback
# ==============================
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Secret para proteger el endpoint de cron
CRON_SECRET="change-this-to-a-random-secret"

# ==============================
# Stripe
# https://dashboard.stripe.com/apikeys
# Crea los productos Creator ($19/mes) y Pro ($49/mes) en el dashboard.
# Webhook events:
#   customer.subscription.created / updated / deleted
#   invoice.payment_succeeded / payment_failed
# ==============================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_PRO=""

# ==============================
# Resend (Email)
# https://resend.com/api-keys
# EMAIL_FROM: "Influctor <noreply@tudominio.com>"
# ==============================
RESEND_API_KEY=""
EMAIL_FROM="Influctor <noreply@tudominio.com>"
